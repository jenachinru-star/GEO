    {"id":"I04","intent_type":"informational","branded":false,"text":"了解{{specialty_secondary}}时，哪些医学来源相对可靠？","purpose":"medical_source_quality"},
    {"id":"I05","intent_type":"informational","branded":false,"text":"患者就诊前应如何整理症状和既往检查资料？","purpose":"visit_preparation"},
    {"id":"I06","intent_type":"informational","branded":false,"text":"医生科普文章中哪些信息应该标明来源和更新时间？","purpose":"content_citation_quality"}
