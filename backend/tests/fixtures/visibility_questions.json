    {"id":"D10","intent_type":"discovery","branded":false,"text":"{{city}}诊治{{specialty_secondary}}的医生通常需要具备哪些专业能力？","purpose":"expertise_criteria"},
    {"id":"D11","intent_type":"discovery","branded":false,"text":"{{specialty_primary}}患者在选择医院和医生时分别要看什么？","purpose":"doctor_hospital_comparison"},
    {"id":"D12","intent_type":"discovery","branded":false,"text":"有哪些渠道可以了解{{city}}{{department}}医生的专业方向和出诊信息？","purpose":"channel_discovery"},

    {"id":"B01","intent_type":"branded","branded":true,"text":"{{doctor_name}}医生目前在哪家医院和哪个科室执业？","purpose":"identity_verification"},
