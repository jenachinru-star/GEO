    {"id":"D05","intent_type":"discovery","branded":false,"text":"{{city}}哪些医院设有诊治{{specialty_primary}}的{{department}}？","purpose":"hospital_discovery"},
    {"id":"D06","intent_type":"discovery","branded":false,"text":"想咨询{{specialty_secondary}}相关问题，应该选择什么专业方向的医生？","purpose":"specialty_discovery"},
    {"id":"D07","intent_type":"discovery","branded":false,"text":"如何核实{{city}}{{department}}医生的公开执业信息？","purpose":"authority_discovery"},
