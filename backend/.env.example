# ============ 系统配置 ============
APP_NAME=GEO Monitor
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
# 生产环境必须修改为强随机字符串
SECRET_KEY=change-me-to-strong-random

# ============ 数据库（默认SQLite，零依赖） ============
DATABASE_URL=sqlite:///./data/geo.db

# ============ AI平台配置（OpenAI兼容格式） ============
# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=deepseek-chat

# GLM（智谱清言）
GLM_API_KEY=
GLM_BASE_URL=
GLM_MODEL=glm-4-flash

# MiniMax
MINIMAX_API_KEY=
MINIMAX_BASE_URL=
MINIMAX_MODEL=MiniMax-M2.7-highspeed

# 豆包（预留）
DOUBAO_API_KEY=
DOUBAO_BASE_URL=
DOUBAO_MODEL=

# 通义千问（预留）
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=

# ============ 监测配置 ============
MONITOR_TIMES_PER_DAY=3
MONITOR_TEMPERATURE=0.3
MONITOR_MAX_TOKENS=2000

# ============ LLM 通用配置（文章生成器使用） ============
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TEMPERATURE=0.7

# ============ 生图配置（Seedream） ============
SEEDREAM_API_KEY=
SEEDREAM_BASE_URL=
SEEDREAM_MODEL=

# ============ IAM单点登录（层次智慧IAM，基于Casdoor） ============
IAM_HOST=https://iam.szcczh.com
IAM_CLIENT_ID=
IAM_CLIENT_SECRET=
IAM_REDIRECT_URI=
# 生产环境必须修改为强随机字符串
JWT_SECRET=change-me-to-strong-random
JWT_EXPIRE_HOURS=24
# 发布账号凭证加密密钥（Fernet key，生产环境必须设置）
ENCRYPT_KEY=

# ============ CORS 与前端地址 ============
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:3000

# ============ 创作工具跳转地址 ============
ARTICLE_TOOL_URL=https://ops.szcczh.com/paper-next/
VIDEO_TOOL_URL=https://video.szcczh.com/
